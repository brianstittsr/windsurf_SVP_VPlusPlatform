{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/eos2/scheduled-checks?check=todos",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/eos2/scheduled-checks?check=rocks",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/eos2/scheduled-checks?check=metrics",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/eos2/weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/capture/alerts/run",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/capture/match/run",
      "schedule": "17 */6 * * *"
    },
    {
      "path": "/api/capture/trash/purge",
      "schedule": "30 6 * * *"
    }
  ]
}
