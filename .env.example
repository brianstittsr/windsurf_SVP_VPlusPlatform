# Environment Configuration — EFVS Academy LMS
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=development

# UserWay Accessibility Widget (optional)
# Get your account ID from https://userway.org/dashboard
NEXT_PUBLIC_USERWAY_ACCOUNT_ID=

# Firebase Client Configuration (public)
# Get these values from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side only — never expose to the browser)
# Used by /api/scorm/* and /api/stripe/* routes
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (server-side only)
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` or the Stripe dashboard
STRIPE_WEBHOOK_SECRET=
# Publishable key exposed to the browser for Stripe.js
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Base URL used for Stripe Checkout success/cancel redirects and invite URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# High-entropy server-side key used to hash registration invitation tokens and rate-limit IPs
REGISTRATION_INVITE_SECRET=

# Optional inbox for new public student registrations
EFVS_REGISTRATION_EMAIL=efvsflight@efvertical.com

# Static LinkedIn Add to Profile provider URL (generate via LinkedIn's provider microsite)
NEXT_PUBLIC_LINKEDIN_ADD_TO_PROFILE_URL=

# SCORM session signing secret (optional — falls back to STRIPE_SECRET_KEY)
# Any high-entropy string; used to sign the scorm_session httpOnly cookie
SCORM_SESSION_SECRET=

# OpenAI — required for Grant Builder AI analysis/drafting and capture AI features
OPENAI_API_KEY=

# SAM.gov public API key — required for opportunity matching cron
# Get one at sam.gov → Sign In → Account Details → Public API Key
SAM_API_KEY=

# GrantedAI API key — optional; falls back to anonymous key (~3 AI searches/day)
# Get a free key at https://grantedai.com (10 searches/day free tier)
GRANTED_AI_API_KEY=

# Cron endpoint authentication — Bearer token required by /api/capture/match/run
CRON_SECRET=

# Transactional email via Microsoft Graph (optional)
# Required for enrollment/payment notification emails
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SMTP_FROM_EMAIL=noreply@efvertical.com
SMTP_FROM_NAME="EFVS Academy"

# Note: NEXT_PUBLIC_* variables are exposed to the browser.
# Everything else is server-side only.
