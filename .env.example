# Environment Configuration
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=development

# UserWay Accessibility Widget
# Get your account ID from https://userway.org/dashboard
NEXT_PUBLIC_USERWAY_ACCOUNT_ID=

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Mattermost Integration
# Get webhook URL from Mattermost > Integrations > Incoming Webhooks
MATTERMOST_WEBHOOK_URL=

# ThomasNet Credentials (for authenticated supplier search)
# Create a free account at https://www.thomasnet.com/register
THOMASNET_EMAIL=
THOMASNET_PASSWORD=

# CONNEX Marketplace Credentials (MEP National Network supplier database)
# Create a free account at https://app.connexmarketplace.com/create-account
# 165,000+ U.S. manufacturers in the database
CONNEX_EMAIL=
CONNEX_PASSWORD=

# Add additional environment variables below as needed
# NEXT_PUBLIC_* variables are exposed to the browser
# Variables without NEXT_PUBLIC_ prefix are server-side only

FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=your_private_key

# SAM.gov Entity Management API
# Get your API key from https://sam.gov/profile/details (Public API Key field)
# For FOUO/Sensitive data, you need a Federal System Account with appropriate permissions
SAM_API_KEY=your_sam_api_key

# Google Maps API
# Get your API key from https://console.cloud.google.com/apis/credentials
# Enable Maps JavaScript API and Maps Embed API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key