rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helpers
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && role() == 'admin';
    }

    function isStaff() {
      return isAuthenticated() && role() in ['admin', 'instructor'];
    }

    function isOwner(field) {
      return isAuthenticated() && resource.data[field] == request.auth.uid;
    }

    function ownsNew(field) {
      return isAuthenticated() && request.resource.data[field] == request.auth.uid;
    }

    // =========================================================================
    // Role lookup — keyed by Firebase Auth UID.
    // Students self-create 'student' at sign-up; elevation requires admin.
    // =========================================================================
    match /roles/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      // Students self-provision at sign-up; admins can write any user's role
      // doc (e.g. first elevation). The first admin must be seeded manually.
      allow create: if isAdmin()
                      || (isAuthenticated()
                            && request.auth.uid == uid
                            && request.resource.data.role == 'student');
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // User records (teamMembers collection — the platform's user profile store)
    // =========================================================================
    match /teamMembers/{userId} {
      allow read: if isStaff() || isOwner('firebaseUid');
      // User profiles are provisioned by the authenticated server bootstrap; admins
      // may also create records (e.g. roster imports and demo students).
      allow create: if isAdmin();
      // Profile edits cannot change identity, role, status, veteran eligibility,
      // or any billing/administrative fields.
      allow update: if isAdmin()
                      || (isOwner('firebaseUid')
                            && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['firstName', 'lastName', 'mobile', 'company', 'location', 'bio', 'avatar', 'linkedIn', 'website', 'title', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Course catalog & content — read by all signed-in users, managed by admin
    // =========================================================================
    match /courses/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /products/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /courseModules/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /questionBanks/{docId} {
      // Learners receive sanitized questions through the authenticated API;
      // answer keys are never exposed through direct client reads.
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /scormPackages/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // Enrollments — staff see all; students see their own
    // =========================================================================
    match /enrollments/{docId} {
      allow read: if isStaff() || isOwner('firebaseUid');
      // Enrollment grants are written by Stripe/Admin SDK or an administrator.
      allow create: if isAdmin();
      // Learners may update only their last-access timestamp from the client.
      allow update: if isStaff() || (isOwner('firebaseUid')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAccessedAt']));
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Learning progress — learners own their records; staff can view all
    // =========================================================================
    match /lessonProgress/{docId} {
      allow read: if isStaff() || isOwner('firebaseUid');
      allow write: if isStaff();
    }
    match /scormRuntime/{docId} {
      allow read: if isStaff() || isOwner('firebaseUid');
      // SCORM commits are validated by the signed-session server route.
      allow write: if false;
    }
    match /examAttempts/{docId} {
      allow read: if isStaff() || isOwner('firebaseUid');
      // Learner attempts are graded and written by the server from the bank answer key.
      allow write: if false;
    }

    // =========================================================================
    // Certificates — readable by owner & staff; issued by the app or admin
    // =========================================================================
    match /certificates/{docId} {
      allow read: if isStaff() || isOwner('firebaseUid');
      // Issuance and sharing changes use authenticated server routes.
      allow write: if false;
    }

    // =========================================================================
    // Billing — invoices/payments are financial records
    // =========================================================================
    match /invoices/{docId} {
      allow read: if isStaff() || isOwner('firebaseUid');
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /payments/{docId} {
      allow read: if isStaff() || isOwner('firebaseUid');
      allow write: if isAdmin();
    }
    match /discountCodes/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // Activity feed & audit logs
    // =========================================================================
    match /activities/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    match /auditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // Platform settings
    // =========================================================================
    match /platformSettings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
